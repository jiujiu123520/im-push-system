[Unit]
Description=IM Push System - WebSocket 推送服务
Documentation=https://github.com/jiujiu123520/im-push-system
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service
# WebSocket 服务在 HTTP API 之后启动（共享数据库/Redis）
After=push-http.service
# 启动失败重试上限
StartLimitBurst=5
StartLimitIntervalSec=30

[Service]
Type=simple
# 项目根目录
WorkingDirectory=/www/push-system/backend
# PHP 可执行文件路径，--ws 参数启动 WebSocket 推送服务
ExecStart=/usr/bin/php /www/push-system/backend/public/index.php --ws
# 优雅停止：SIGTERM 后 WorkerStop 释放定时器与心跳，Swoole 完成连接清理后退出，
# 实测耗时 ≈ max_wait_time（5 秒）；30 秒只是兜底上限。
# ⚠️ 必须大于 Swoole 的 max_wait_time（WebSocketServer::configure 中为 5s），
#    否则 Swoole 还没退出就会被 SIGKILL。
KillSignal=SIGTERM
TimeoutStopSec=30
# 自动重启：崩溃后 3 秒重启
Restart=always
RestartSec=3
# 以指定用户运行（避免 root 权限）
User=www-data
Group=www-data
# 环境变量
Environment=APP_ENV=production
# 标准输出重定向到 journalctl
StandardOutput=journal
StandardError=journal
SyslogIdentifier=push-websocket

[Install]
WantedBy=multi-user.target
